# Copy this file to ".env" (in this backend folder) and fill in your own values.
# .env is listed in .gitignore, so your password never ends up on GitHub.

PORT=3000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=iron_prep

# Secret used to sign the login cookie. Any long random text works.
SESSION_SECRET=change-me-to-a-long-random-string
